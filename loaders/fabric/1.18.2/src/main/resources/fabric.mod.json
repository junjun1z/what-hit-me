{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": { "homepage": "${mod_homepage}", "sources": "${mod_homepage}", "issues": "${mod_issues}" },
  "license": "${mod_license}",
  "icon": "assets/whathitme/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.junjun1z.whathitme.fabric.WhatHitMeFabric"],
    "client": ["io.github.junjun1z.whathitme.fabric.WhatHitMeFabricClient"]
  },
  "mixins": ["whathitme.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15",
    "fabric": "*",
    "minecraft": "${mc_range}",
    "java": ">=${java_version}"
  }
}
